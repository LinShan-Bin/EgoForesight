# Edit these placeholders. Source from the EgoForesight root if desired.
export PYTHONPATH="$PWD"
export QWEN_MODEL=/absolute/path/to/Qwen3.5-4B
export DINO_REPO=/absolute/path/to/dinov3
export DINO_WEIGHTS=/absolute/path/to/dinov3_vitb16_weights.pth
export PRETRAINED_CHECKPOINT=/absolute/path/to/egofore_checkpoint.pt
export DATA_ROOT=/absolute/path/to/prepared/simulation/data
export R1PRO_CACHE=/absolute/path/to/r1pro/camera_spatial_cache
export R1PRO_DATASET_ID=r1pro_my_task
export POLICY_PYTHON=/absolute/path/to/egofore/bin/python
export ROBOTWIN_ROOT=/absolute/path/to/RoboTwin
export ROBOTWIN_PYTHON=/absolute/path/to/robotwin/bin/python
export ROBOCASA_PYTHON=/absolute/path/to/robocasa/bin/python
